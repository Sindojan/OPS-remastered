# Datenbank
DB_NAME=owlsburg_ops
DB_USER=owlsburg_app
DB_PASSWORD=sicheres-passwort-hier

# MinIO
MINIO_ROOT_USER=owlsburg-admin
MINIO_ROOT_PASSWORD=sicheres-passwort-hier

# JWT (min. 32 Zeichen, zufällig generieren)
JWT_SECRET=zufaelliger-string-min-32-zeichen

# Verschlüsselung (für API Keys in DB, min. 32 Zeichen)
ENCRYPTION_KEY=zufaelliger-string-min-32-zeichen

# CORS (kommagetrennt, für Produktion die echte Domain)
CORS_ALLOWED_ORIGINS=http://localhost

# API URL (Frontend nutzt diese URL für API-Calls)
API_URL=http://localhost/api

# HTTP Port (Nginx)
HTTP_PORT=80
